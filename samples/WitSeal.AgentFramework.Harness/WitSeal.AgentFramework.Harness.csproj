<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- This executable harness requires the .NET 10 runtime; the adapter
         library itself targets net8.0. global.json pins the build SDK. -->
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/WitSeal.AgentFramework/WitSeal.AgentFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.AI provides AIFunctionArguments used to invoke the
         authored AIFunction directly in the harness. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.9.0" />
  </ItemGroup>

</Project>
